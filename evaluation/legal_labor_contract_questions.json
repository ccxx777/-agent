        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["十五日内", "社会保险关系转移"]
      }
    },
    {
      "question_id": "labor_legal_08",
      "query": "超过一个月不满一年没有签书面劳动合同，双倍工资如何支付？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第八十二条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["超过一个月不满一年", "每月支付二倍的工资"]
