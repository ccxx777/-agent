        "doc_id": "labor_contract_law_20121228",
        "article_no": "第十条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["书面劳动合同", "一个月"]
      }
    },
    {
      "question_id": "labor_legal_02",
      "query": "劳动合同必须具备哪些主要条款？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第十七条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["用人单位", "劳动者", "劳动报酬", "社会保险"]
      }
    },
    {
      "question_id": "labor_legal_03",
      "query": "三年以上固定期限劳动合同的试用期最长可以约定多久？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第十九条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["三年以上固定期限", "六个月"]
      }
    },
    {
      "question_id": "labor_legal_04",
      "query": "用人单位应当如何支付劳动者的劳动报酬？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第三十条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["及时足额支付劳动报酬"]
      }
    },
    {
      "question_id": "labor_legal_05",
      "query": "用人单位拖欠工资或没有依法缴纳社会保险费，劳动者可以解除劳动合同吗？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第三十八条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["未及时足额支付劳动报酬", "未依法为劳动者缴纳社会保险费"]
      }
    },
    {
      "question_id": "labor_legal_06",
      "query": "哪些情形下用人单位应当向劳动者支付经济补偿？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
        "article_no": "第四十六条",
        "effective_date": "2013-07-01",
        "official_url_prefix": "https://flk.npc.gov.cn/",
        "required_terms": ["支付经济补偿", "第三十八条"]
      }
    },
    {
      "question_id": "labor_legal_07",
      "query": "劳动合同解除或终止后，用人单位多少日内应办理档案和社会保险关系转移？",
      "expected": {
        "doc_id": "labor_contract_law_20121228",
